{
	"manifest_version": 3,
	"name": "Jobduit",
	"version": "1.0.0",
	"key": "",
	"description": "Capture job postings from LinkedIn, Indeed, Greenhouse and Lever into your Jobduit tracker.",
	"icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
	"action": {
		"default_title": "Jobduit",
		"default_popup": "index.html",
		"default_icon": "icon.png"
	},
	"background": {
		"service_worker": "src/background.ts"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.linkedin.com/jobs/*",
				"https://*.indeed.com/*",
				"https://*.greenhouse.io/*",
				"https://jobs.lever.co/*"
			],
			"js": ["src/content.ts"],
			"run_at": "document_idle"
		}
	],
	"permissions": ["storage"],
	"host_permissions": [
		"https://www.linkedin.com/jobs/*",
		"https://*.indeed.com/*",
		"https://*.greenhouse.io/*",
		"https://jobs.lever.co/*"
	]
}
