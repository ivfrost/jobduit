# Copy this file to .env and adjust the values.
# .env is gitignored, never commit real credentials.

NODE_ENV=development
PORT=3000

# Postgres container (docker-compose.yml)
POSTGRES_USER=jobduit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobduit
POSTGRES_PORT=15432

# Read by Prisma and the app. Expanded via dotenv-expand.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional in dev, required in prod. 32 chars, a-p only.
CHROME_EXTENSION_ID=

# Post analysis. Provider is one of: deepseek | gemini | anthropic
LLM_PROVIDER=
LLM_API_KEY=
# Per provider, e.g. deepseek-chat | gemini-2.5-flash | claude-opus-5-5
LLM_MODEL_NAME=