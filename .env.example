# Copy this file to .env and adjust the values.
# .env is gitignored, never commit real credentials.

# Read by the Postgres container (docker-compose.yml)
POSTGRES_USER=jobduit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobduit

# Read by Prisma and the app. Host port 15432 matches the mapping in docker-compose.yml.
# Uses variable expansion, so this file must be loaded with dotenv-expand
# (prisma7.config.ts and the app entry point), not plain dotenv or --env-file.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:15432/${POSTGRES_DB}"